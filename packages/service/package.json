{
  "name": "@appneurox/techlyup-service",
  "version": "0.1.0",
  "description": "Techlyup Service: NestJS module that runs as its own microservice or inside a modular monolith.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/APPNEURAL-Microservices/techlyup-service.git",
    "directory": "packages/service"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./standalone": {
      "types": "./dist/standalone.d.ts",
      "require": "./dist/standalone.js",
      "default": "./dist/standalone.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/standalone.js",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@appneurox/service-runtime": "^0.1.0",
    "@appneurox/service-composition": "^0.1.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0"
  },
  "devDependencies": {
    "@appneurox/service-runtime": "0.1.0",
    "@appneurox/service-composition": "0.1.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "multer": "2.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
