{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "techlyup-app-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "development",
    "APP_ENABLED": "false",
    "APP_PRODUCTS_ENABLED": "false",
    "APP_SUPPORT_CREDITS_ENABLED": "false",
    "APP_SUPPORT_TEST_PAYMENTS_ENABLED": "false",
    "APP_SIGNUP_ENABLED": "false",
    "APP_ANALYTICS_ENABLED": "false",
    "APP_LEARNING_ENABLED": "false",
    "APP_PLATFORM_ENABLED": "false",
    "APP_CRM_ENABLED": "false",
    "APP_CRM_CAPTURE_ENABLED": "false",
    "APP_CRM_WEBINAR_ENABLED": "false",
    "APP_CRM_SENDING_ENABLED": "false",
    "APP_CRM_INTEGRATIONS_ENABLED": "false",
    "CRM_ANALYTICS_EXPORT_ENABLED": "false",
    "TECHLYUP_ERP_ORG_ID": "appneural",
    "APP_ALLOWED_ORIGINS": "http://localhost:8081,http://127.0.0.1:8081,http://localhost:8788,http://127.0.0.1:8788"
  },
  "d1_databases": [{
    "binding": "REGISTRATIONS_DB",
    "database_name": "techlyup-app-local-only",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "../../migrations/d1"
  }, {
    // Private Studio drafts only. A dedicated database, never the canonical registrations store.
    "binding": "STUDIO_DB",
    "database_name": "techlyup-studio-local-only",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "../../migrations/studio"
  }],
  // /studio/<app>/* reaches the gateway, which forwards released apps to their own Workers
  // and otherwise returns this app's page from ASSETS (src/products/gateway.ts).
  "services": [
    { "binding": "STUDIO_COURSES", "service": "techlyup-courses" },
    { "binding": "STUDIO_MENTORSHIP", "service": "techlyup-mentorship" },
    { "binding": "STUDIO_CERTIFICATES", "service": "techlyup-certificates" },
    { "binding": "STUDIO_LEARNERS", "service": "techlyup-learners" },
    { "binding": "STUDIO_EARNINGS", "service": "techlyup-earnings" },
    { "binding": "STUDIO_PROMOTION", "service": "techlyup-promotion" },
    { "binding": "STUDIO_INSIGHTS", "service": "techlyup-insights" },
    { "binding": "STUDIO_ASSISTANT", "service": "techlyup-assistant" }
  ],
  "assets": { "directory": "public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/support/link", "/studio/*"] },
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 * * * *"] },
  "limits": { "cpu_ms": 30000 },
  "env": {
    // app.techlyup.com: passwordless registration, email-code sign-in and TechlyUp LIVE sign-in only. Every other capability stays off.
    // Canonical learner accounts live in the website's existing D1 (techlyup-site REGISTRATIONS_DB).
    "production": {
      "name": "techlyup-app-api",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "app.techlyup.com", "custom_domain": true }],
      "vars": {
        "APP_ENV": "production",
        "APP_ENABLED": "true",
        "APP_PRODUCTS_ENABLED": "false",
        "APP_SIGNUP_ENABLED": "true",
        "APP_LIVE_LOGIN_ENABLED": "true",
        "LIVE_LOGIN_CLIENT_ID": "techlyup-live",
        "LIVE_LOGIN_APP_ORIGIN": "https://app.techlyup.com",
        "LIVE_LOGIN_CALLBACK_URL": "https://live.techlyup.com/api/auth/techlyup/callback",
        "APP_SUPPORT_CREDITS_ENABLED": "false",
        "APP_SUPPORT_TEST_PAYMENTS_ENABLED": "false",
        "APP_ANALYTICS_ENABLED": "false",
        "APP_LEARNING_ENABLED": "false",
        "APP_PLATFORM_ENABLED": "false",
        "APP_CRM_ENABLED": "false",
        "APP_CRM_CAPTURE_ENABLED": "false",
        "APP_CRM_WEBINAR_ENABLED": "false",
        "APP_CRM_SENDING_ENABLED": "false",
        "APP_CRM_INTEGRATIONS_ENABLED": "false",
        "CRM_ANALYTICS_EXPORT_ENABLED": "false",
        "TECHLYUP_ERP_ORG_ID": "appneural",
        "APP_ALLOWED_ORIGINS": "https://app.techlyup.com",
        "EMAIL_FROM": "admin@notify.techlyup.com"
      },
      // Sign-in codes. Same verified Cloudflare Email Sending sender as TechlyUp LIVE.
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["admin@notify.techlyup.com"] }],
      "d1_databases": [{
        "binding": "REGISTRATIONS_DB",
        "database_name": "techlyup-registrations",
        "database_id": "e98173f2-34c9-4b47-b36c-755d2bf775dd",
        "migrations_dir": "../../migrations/d1"
      }]
    }
  }
}
