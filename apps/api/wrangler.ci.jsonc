{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // API source packaging only: no web assets, public routes or live credentials.
  "name": "techlyup-api-source-validation",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "test",
    "APP_ENABLED": "false",
    "APP_PRODUCTS_ENABLED": "false",
    "APP_SUPPORT_CREDITS_ENABLED": "false",
    "APP_SUPPORT_TEST_PAYMENTS_ENABLED": "false",
    "APP_SIGNUP_ENABLED": "false",
    "APP_ANALYTICS_ENABLED": "false",
    "APP_LEARNING_ENABLED": "false",
    "APP_PLATFORM_ENABLED": "false",
    "TECHLYUP_ERP_ORG_ID": "appneural",
    "APP_ALLOWED_ORIGINS": "http://127.0.0.1:8788"
  },
  "d1_databases": [{
    "binding": "REGISTRATIONS_DB",
    "database_name": "techlyup-ci-local-only",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "../../migrations/d1"
  }]
}
