{
  "name": "@techlyup/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8788",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "migrate:local": "wrangler d1 migrations apply REGISTRATIONS_DB --local",
    "db:local": "node scripts/bootstrap-local.mjs"
  },
  "dependencies": {
    "@appneurox/learning-postgres": "file:../../vendor/appneurox-learning-postgres-0.1.0.tgz",
    "@appneurox/platform-client": "0.1.0",
    "@appneurox/razorpay-invoice-core": "file:../../vendor/appneurox-razorpay-invoice-core-0.1.0.tgz",
    "@techlyup/contracts": "0.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "wrangler": "^4.151.0"
  }
}
